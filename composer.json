{
    "name": "mosaic/luxury-concierge",
    "type": "project",
    "description": "Mosaic - Luxury Experience Booking, AI Concierge Orchestrator, Admin & RBAC Platform (Laravel / MySQL / Plesk)",
    "keywords": ["mosaic", "luxury", "concierge", "laravel", "rbac", "spatie", "mysql", "plesk"],
    "license": "proprietary",
    "require": {
        "php": "^8.0.2|^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "laravel/framework": "^10.0|^11.0",
        "spatie/laravel-permission": "^5.10|^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Migrations\\": "database/migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('config/env.plesk.template', '.env');\""
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
